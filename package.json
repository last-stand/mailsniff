{
  "name": "mailsniff",
  "version": "0.1.0",
  "description": "Detect disposable email addresses and domains, with an in-memory or Redis-backed cache and automatic dataset refresh.",
  "keywords": [
    "disposable-email",
    "temporary-email",
    "email-validation",
    "throwaway-email",
    "blocklist",
    "redis"
  ],
  "license": "MIT",
  "author": "MailSniff contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/last-stand/mailsniff.git"
  },
  "bugs": {
    "url": "https://github.com/last-stand/mailsniff/issues"
  },
  "homepage": "https://github.com/last-stand/mailsniff#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:coverage": "vitest run test/unit --coverage",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@eslint/js": "^9.14.0",
    "@types/node": "^18.19.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.14.0",
    "globals": "^17.13.0",
    "ioredis": "^5.4.0",
    "prettier": "^3.3.0",
    "publint": "^0.2.12",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.0"
  }
}
